# ── Lovable Cloud / Supabase (obrigatórias para o build) ──────────────
# No Lovable essas variáveis são injetadas automaticamente.
# Para CI/local, copie este arquivo para .env e preencha os valores
# (ou configure como GitHub Actions secrets — ver .github/workflows/ci.yml).

VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxx"
VITE_SUPABASE_PROJECT_ID="your-project-ref"

# Alias legado usado por alguns módulos (mesmo valor da publishable key)
VITE_SUPABASE_ANON_KEY="sb_publishable_xxxxxxxx"

# ── PrimeOS app (opcionais — têm fallback no código) ───────────────────
VITE_PRIMEOS_APP_ID=""
VITE_APP_ID=""
VITE_PRIMEOS_APP_BASE_URL=""
VITE_PRIMEOS_FUNCTIONS_VERSION=""

# ── Functions/API base (opcionais — fallback '/api/functions') ─────────
# VITE_FUNCTIONS_API_URL=""
# VITE_BACKEND_API_URL=""
